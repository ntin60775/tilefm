sources = files(
    'main.vala',
    'application.vala',
    'window.vala',
    'core/async_worker.vala',
    'core/archive_plugin.vala',
    'core/clipboard_manager.vala',
    'core/custom_actions.vala',
    'core/file_manager.vala',
    'core/file_searcher.vala',
    'core/layout_manager.vala',
    'core/thumbnail_manager.vala',
    'core/trash_manager.vala',
    'core/undo_manager.vala',
    'tile/tile.vala',
    'tile/tile_container.vala',
    'view/file_view.vala',
    'view/icon_view.vala',
    'view/list_view.vala',
    'widgets/breadcrumb_pathbar.vala',
    'widgets/bulk_rename_dialog.vala',
    'widgets/context_menu.vala',
    'widgets/preview_panel.vala',
    'widgets/quick_look.vala',
    'widgets/typeahead_search.vala',
)

tilefm_deps = [
    glib_dep,
    gobject_dep,
    gtk_dep,
    gio_dep,
    gee_dep,
    json_dep,
]

executable('tilefm',
    sources,
    dependencies: tilefm_deps,
    install: true,
)